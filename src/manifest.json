{
  "manifest_version": 3,
  "name": "MeetingTranscriptToObsidian",
  "version": "0.0.4",
  "minimum_chrome_version": "114",
  "description": "Meeting transcripts from Google Meet, Teams and Zoom, saved to your Obsidian vault. Private and open source.",
  "author": {
    "email": "muhammadnuman70@gmail.com"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icon.png"
    },
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "sidePanel"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://chat.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*"],
      "js": ["contentGoogleMeetChat.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "notifications"
  ],
  "optional_host_permissions": [
    "*://*/*",
    "https://*.zoom.us/",
    "https://teams.live.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.microsoft.com.mcas.ms/*",
    "https://teams.cloud.microsoft.mcas.ms/*",
    "https://teams.microsoft.com.mcas-gov.us/*",
    "https://teams.cloud.microsoft.mcas-gov.us/*",
    "https://teams.microsoft.com.mcas-gov.ms/*",
    "https://teams.cloud.microsoft.mcas-gov.ms/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": [
        "https://meet.google.com/*",
        "https://teams.live.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.microsoft.com.mcas.ms/*",
        "https://teams.cloud.microsoft.mcas.ms/*",
        "https://teams.microsoft.com.mcas-gov.us/*",
        "https://teams.cloud.microsoft.mcas-gov.us/*",
        "https://teams.microsoft.com.mcas-gov.ms/*",
        "https://teams.cloud.microsoft.mcas-gov.ms/*",
        "https://*.zoom.us/*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  }
}