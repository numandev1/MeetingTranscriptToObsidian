{
  "name": "meetingtranscripttoobsidian",
  "private": true,
  "version": "0.0.4",
  "description": "Meeting transcripts from Google Meet, Teams and Zoom, saved to your Obsidian vault. Private and open source.",
  "author": "muhammadnuman70@gmail.com",
  "scripts": {
    "build": "node utils/dev-build.js",
    "start": "node utils/watch.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.json --outDir .test-build --module commonjs --moduleResolution node --noEmit false --declaration false",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check:selectors": "node scripts/check-selectors.mjs",
    "cws:auth": "node scripts/cws-auth.mjs",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"test/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\"",
    "zip": "NODE_ENV=production ./node_modules/.bin/webpack --config ./utils/build.js --mode production"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.317",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.0",
    "prettier": "^3.9.6",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.3",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "zip-webpack-plugin": "^4.0.1"
  }
}
